# Copy to .env (or set in your host's dashboard). Without MONGODB_URI the
# server falls back to a local JSON file store (server/.data/db.json) —
# fine for local dev, not for production.

MONGODB_URI=
PORT=4000

# Only needed if this host requires an egress proxy for outbound HTTP.
# HTTPS_PROXY=

# ---- Scraper tuning (all optional; safe defaults, favor data over speed) ----
# Hard cap on a whole scrape run so it can never hang. Default 240000 (4 min).
# A scrape runs as a background job (client polls /api/scrape/status, not a
# blocking request), so there's no reason to keep this artificially short —
# lower it back down for the original fast/shallow behaviour if you want.
# SCRAPE_RUN_BUDGET_MS=240000
# Per-source cap. A stalled source is abandoned after this. Default 60000 (1 min).
# SCRAPE_SOURCE_TIMEOUT_MS=60000
# Max pages/URLs fetched per source. Lower = faster. Default 4.
# SCRAPE_MAX_PAGES=4
# Restrict which sources run, comma-separated keys. Default: all.
# Keys: clutch, autotrader, cargurus, waynetoyota, goremotorshonda,
#       halfwaymotorsmazda, superiorhyundai
# SCRAPE_SOURCES=clutch
# Allow the Playwright browser fallback (needs a local Chromium — `npx
# playwright install chromium` — or the Apify rendering service above). ON by
# default; set to 0 to disable. Used by: CarGurus and any generic HTML dealer
# scraper's JS fallback, AutoTrader's render top-up pass, and Clutch's
# browser-session retry for models the direct JSON API call couldn't reach.
# SCRAPE_JS_FALLBACK=1
# Single HTTP request timeout / parallel requests per source.
# SCRAPE_REQUEST_TIMEOUT_MS=12000
# SCRAPE_CONCURRENCY=4

# ---- External rendering service: Apify (optional) ---------------------------
# Lets JS-rendered sites (CarGurus, the OEM new-car pages, JS dealer sites) be
# scraped from a host WITHOUT a local Chromium (e.g. Render) — Apify runs the
# actual browser on its own infrastructure. The specific reason to use Apify
# rather than a generic rendering API: its Proxy product includes residential
# IPs, which is the one lever that can plausibly get past a site that blocks
# by IP reputation (CarGurus's DataDome) rather than by browser/JS
# fingerprinting — a plain datacenter IP gets the same 403 whether or not a
# real browser is behind it.
# Get a token at https://console.apify.com/settings/integrations
# APIFY_TOKEN=
# Which actor renders the page. Default is Apify's official, stable
# "apify/web-scraper" — deliberately not one of the higher-level "content
# crawler" actors, which extract readable text and typically strip the
# <script> JSON-LD blocks / embedded state objects this app's extractor needs.
# APIFY_ACTOR_ID=apify~web-scraper
# Comma list of Apify Proxy groups. Default RESIDENTIAL (the IP-reputation
# lever above). Set to NONE to disable proxying — cheaper/faster, but back to
# a datacenter-ish IP; only useful for JS-rendering needs that aren't also
# being IP-blocked.
# APIFY_PROXY_GROUPS=RESIDENTIAL
# Bias the residential IP toward a country, e.g. CA. Unset = any.
# APIFY_PROXY_COUNTRY=CA
# Per-render cap; an actor run has more overhead than a direct API call (cold
# start, navigation, the page function).
# RENDER_SERVICE_TIMEOUT_MS=45000
