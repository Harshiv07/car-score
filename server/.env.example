# Copy to .env (or set in your host's dashboard). Without MONGODB_URI the
# server falls back to a local JSON file store (server/.data/db.json) —
# fine for local dev, not for production.

MONGODB_URI=
PORT=4000

# Only needed if this host requires an egress proxy for outbound HTTP.
# HTTPS_PROXY=

# ---- Scraper tuning (all optional; safe fast defaults) ----------------------
# Hard cap on a whole scrape run so it can never hang. Default 180000 (3 min) —
# CarGurus's per-model browser renders take real wall-clock time on the rare
# run where this network isn't DataDome-blocked, so this has more headroom
# than the other, much faster sources need on their own.
# SCRAPE_RUN_BUDGET_MS=180000
# Per-source cap. A stalled source is abandoned after this. Default 90000.
# SCRAPE_SOURCE_TIMEOUT_MS=90000
# Max pages/URLs fetched per *generic* dealer source. Lower = faster. Default 4.
# (AutoTrader and Clutch have their own knobs below — this one doesn't apply
# to them; reusing it for AutoTrader once silently dropped 6 of 10 models.)
# SCRAPE_MAX_PAGES=4
# AutoTrader: pages of ~20 Ontario listings to fetch per model (browser-free
# via &page=N). Default 6 (~6 x 10 models =~ 1000+ listings).
# AUTOTRADER_PAGES_PER_MODEL=6
# Clutch: max pages to attempt on the single all-models combined query before
# switching to per-model top-up requests. Default 3 — deliberately small:
# verified live on Render that the WAF's whole per-run budget is only ~6-8
# requests total, and letting main pagination use all of it left nothing for
# the per-model top-up that targets the specific under-represented models.
# CLUTCH_MAX_PAGES=3
# Clutch: which fulfilment location's price/delivery fields get attached.
# Default is Brampton, ON — verified this doesn't change which vehicles are
# returned (Ontario inventory is the same across Ontario location ids).
# CLUTCH_LOCATION_ID=f44ec589-4108-4f38-a3bf-2097d65a05a6
# Restrict which sources run, comma-separated keys. Default: all.
# Keys: clutch, autotrader, cargurus, waynetoyota, goremotorshonda,
#       halfwaymotorsmazda, superiorhyundai
# SCRAPE_SOURCES=clutch
# Allow the slow Playwright browser fallback for the HTML sources (needs
# Chromium: `npx playwright install chromium`). Off by default. Set to 1 to
# render the JS dealer sites locally. Clutch does NOT need this (JSON API).
# SCRAPE_JS_FALLBACK=0
# Single HTTP request timeout / parallel requests per source.
# SCRAPE_REQUEST_TIMEOUT_MS=12000
# SCRAPE_CONCURRENCY=4

# ---- External rendering service (optional) ----------------------------------
# Lets JS-rendered sites (CarGurus, the OEM new-car pages, JS dealer sites) be
# scraped from a host WITHOUT a local Chromium (e.g. Render). Setting this also
# turns the JS fallback on automatically. (AutoTrader and Clutch don't need
# this — both are browser-free.)
#   - If the URL contains "{url}", it's called with GET and {url} replaced by the
#     URL-encoded target (ScrapingBee, ScraperAPI, Zenrows, …):
# RENDER_SERVICE_URL=https://app.scrapingbee.com/api/v1/?api_key=YOUR_KEY&render_js=true&url={url}
#   - Otherwise it's called with POST { url } (Browserless /content, etc.):
# RENDER_SERVICE_URL=https://production-sfo.browserless.io/content?token=YOUR_TOKEN
# RENDER_SERVICE_API_KEY=
# RENDER_SERVICE_TIMEOUT_MS=30000
