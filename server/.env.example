# Copy to .env (or set in your host's dashboard). Without MONGODB_URI the
# server falls back to a local JSON file store (server/.data/db.json) —
# fine for local dev, not for production.

MONGODB_URI=
PORT=4000

# Only needed if this host requires an egress proxy for outbound HTTP.
# HTTPS_PROXY=

# ---- Scraper tuning (all optional; safe fast defaults) ----------------------
# Hard cap on a whole scrape run so it can never hang. Default 120000 (2 min).
# SCRAPE_RUN_BUDGET_MS=120000
# Per-source cap. A stalled source is abandoned after this. Default 30000.
# SCRAPE_SOURCE_TIMEOUT_MS=30000
# Max pages/URLs fetched per source. Lower = faster. Default 4.
# SCRAPE_MAX_PAGES=4
# Restrict which sources run, comma-separated keys. Default: all.
# Keys: clutch, autotrader, cargurus, waynetoyota, goremotorshonda,
#       halfwaymotorsmazda, superiorhyundai
# SCRAPE_SOURCES=clutch
# Allow the slow Playwright browser fallback for the HTML sources (needs
# Chromium: `npx playwright install chromium`). Off by default. Set to 1 to
# render the JS dealer sites locally. Clutch does NOT need this (JSON API).
# SCRAPE_JS_FALLBACK=0
# Single HTTP request timeout / parallel requests per source.
# SCRAPE_REQUEST_TIMEOUT_MS=12000
# SCRAPE_CONCURRENCY=4

# ---- External rendering service (optional) ----------------------------------
# Lets JS-rendered sites (AutoTrader, the OEM new-car pages, JS dealer sites) be
# scraped from a host WITHOUT a local Chromium (e.g. Render). Setting this also
# turns the JS fallback on automatically.
#   - If the URL contains "{url}", it's called with GET and {url} replaced by the
#     URL-encoded target (ScrapingBee, ScraperAPI, Zenrows, …):
# RENDER_SERVICE_URL=https://app.scrapingbee.com/api/v1/?api_key=YOUR_KEY&render_js=true&url={url}
#   - Otherwise it's called with POST { url } (Browserless /content, etc.):
# RENDER_SERVICE_URL=https://production-sfo.browserless.io/content?token=YOUR_TOKEN
# RENDER_SERVICE_API_KEY=
# RENDER_SERVICE_TIMEOUT_MS=30000
